MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Secret for HMAC-SHA256 of phones/emails/payment handles/IBANs. Long random string.
IDENTIFIER_SECRET=change-me
# Optional: enables LLM-written verdict summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEMO=1
# Shared DB is "scamring"; personal sandboxes are scamring_a, scamring_b, scamring_c, scamring_d.
DB_NAME=scamring
# Demo moderator authentication. Set a private value in .env; enter it on /moderate.
# If unset, the server falls back to 1234.
MODERATOR_PIN=
# 0: run the change-stream worker with npm run dev:all.
# 1: deliver alerts inline after confirmation as a worker fallback.
FANOUT_INLINE=0
