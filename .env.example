MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Secret for HMAC-SHA256 of phones/emails/payment handles/IBANs. Long random string.
IDENTIFIER_SECRET=change-me
# Optional: enables LLM-written verdict summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEMO=1
# Shared DB is "scamring"; personal sandboxes are scamring_a, scamring_b, scamring_c, scamring_d.
DB_NAME=scamring
# Private demo moderator PIN; moderation is disabled when unset. /moderate and POST /api/moderation/[id]
# take it as "pin" in the JSON body; POST /api/moderation/agent takes it in the x-moderator-pin header.
MODERATOR_PIN=
# 1: inline alerts; 0: run npm run worker (or npm run dev:all).
FANOUT_INLINE=0

# AI moderator (lib/agent), optional.
# TensorX LLM, assumed OpenAI chat-completions compatible; calls ${TENSORX_BASE_URL}/chat/completions.
TENSORX_API_KEY=
TENSORX_BASE_URL=
TENSORX_MODEL=
# Connection string of a READ-ONLY database user, used only by the MongoDB MCP server (started with --readOnly).
MDB_MCP_CONNECTION_STRING=
# Where the agent calls the moderation API. When unset: the request's origin, or http://localhost:3000 from the CLI.
APP_BASE_URL=http://localhost:3000
